# === Mobile (Expo) - mobile/.gitignore also ignores the generated android/ and ios/ folders ===
node_modules/
.expo/
*.apk
*.aab

# === Python / Tools ===
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (.venv = tools, .venv-convert = Windows converter)
.venv/
.venv-*/
env/
venv/
ENV/

# Model outputs & checkpoints (the shipped model lives in mobile/assets/models/)
out/
dist/
build/
bin/
*.egg-info/
*.pt
*.pth
*.onnx

# Photos / local test datasets (large files)
photos/

# Local archives
*.zip

# === IDE and OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
