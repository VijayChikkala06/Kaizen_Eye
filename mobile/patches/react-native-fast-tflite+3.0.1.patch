+// [kaizen-eye patch] Delegates must outlive their interpreter and were never freed; the app creates and discards
+// NNAPI / GPU interpreters while benchmarking accelerators, so free each delegate after its interpreter.
+void deleteDelegate(TensorflowModelDelegate delegateType, TfLiteDelegate* delegate) {
+  if (delegate == nullptr)
+    return;
+  switch (delegateType) {
+#ifdef ANDROID
+    case TensorflowModelDelegate::NNAPI:
+      TfLiteNnapiDelegateDelete(delegate);
+      return;
+    case TensorflowModelDelegate::ANDROID_GPU:
+      TfLiteGpuDelegateV2Delete(delegate);
+      return;
+#endif
+#if defined(__APPLE__) && FAST_TFLITE_ENABLE_CORE_ML
+    case TensorflowModelDelegate::CORE_ML:
+      TfLiteCoreMlDelegateDelete(delegate);
+      return;
+#endif
+    default:
+      return;
+  }
