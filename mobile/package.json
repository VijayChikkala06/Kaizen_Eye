{
  "name": "kaizen-eye",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.37.1"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
